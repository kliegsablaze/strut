{
  "id": "strut",
  "name": "Strut",
  "abbrev": "STR",
  "version": "0.12.4",
  "dsp": "dsp.so",
  "api_version": 2,
  "component_type": "sound_generator",
  "description": "A drum instrument: sixteen pads, each built from a resonator, an oscillator and a noise source.",
  "capabilities": {
    "audio_out": true,
    "midi_in": true,
    "chainable": true,
    "component_type": "sound_generator",
    "canvas_script": "canvas.js",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Pad",
          "child_count": 16,
          "child_label": "Pad",
          "child_key_template": "p{index}_{key}",
          "child_index_base": 1,
          "child_index_digits": 2
        }
      }
    }
  }
}
